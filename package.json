{
  "name": "point-manager",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "workspaces": {
    "packages": [
      "apps/api",
      "packages/*"
    ],
    "catalog": {
      "@replit/vite-plugin-cartographer": "^0.5.0",
      "@replit/vite-plugin-dev-banner": "^0.1.1",
      "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
      "@tailwindcss/vite": "^4.1.14",
      "@tanstack/react-query": "^5.90.21",
      "@types/node": "^25.3.3",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-orm": "^0.45.1",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.545.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.14",
      "tsx": "^4.21.0",
      "vite": "^7.3.0",
      "zod": "^3.25.76"
    }
  },
  "scripts": {
    "dev": "node ./scripts/next-dev.mjs",
    "start": "node ./scripts/next-start.mjs",
    "build": "node ./scripts/next-build.mjs",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.typecheck.json --noEmit",
    "vercel:build": "bun run build",
    "vercel:dev": "bun run dev",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "build:auth": "bun run --cwd packages/auth build",
    "build:api": "bun run --cwd apps/api build",
    "build:client": "bun run --cwd packages/api-client build",
    "typecheck:workspace": "bun run --cwd packages/auth typecheck && bun run --cwd apps/api typecheck && bun run --cwd packages/api-client typecheck",
    "prisma:generate": "bun run --cwd apps/api prisma:generate",
    "prisma:migrate": "bun run --cwd apps/api prisma:migrate",
    "orval": "bun run --cwd packages/api-client generate",
    "hello": "bun run --cwd scripts hello"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.5.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@point-manager/auth": "file:packages/auth",
    "@prisma/client": "6.19.2",
    "@tabler/icons-react": "^3.40.0",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lucide-react": "^0.577.0",
    "next": "15.5.13",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "recharts": "2.15.4",
    "shadcn": "^4.0.6",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@types/node": "^24.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "prisma": "6.19.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
