{
  "name": "point-manager",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.6",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "artifacts/*",
      "lib/*",
      "lib/integrations/*",
      "scripts"
    ],
    "catalog": {
      "@replit/vite-plugin-cartographer": "^0.5.0",
      "@replit/vite-plugin-dev-banner": "^0.1.1",
      "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
      "@tailwindcss/vite": "^4.1.14",
      "@tanstack/react-query": "^5.90.21",
      "@types/node": "^25.3.3",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@vitejs/plugin-react": "^5.0.4",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-orm": "^0.45.1",
      "framer-motion": "^12.23.24",
      "lucide-react": "^0.545.0",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.14",
      "tsx": "^4.21.0",
      "vite": "^7.3.0",
      "zod": "^3.25.76"
    }
  },
  "scripts": {
    "dev": "bunx concurrently -n web,api -c green,blue \"bun run dev:web\" \"bun run dev:api\"",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "vercel:build": "bun run --cwd apps/web build",
    "vercel:dev": "bun run --cwd apps/web dev",
    "build": "bun run build:auth && bun run build:web && bun run build:api && bun run build:client",
    "build:auth": "bun run --cwd packages/auth build",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "build:client": "bun run --cwd packages/api-client build",
    "typecheck": "bun run --cwd packages/auth typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck && bun run --cwd packages/api-client typecheck",
    "prisma:generate": "bun run --cwd apps/api prisma:generate",
    "prisma:migrate": "bun run --cwd apps/api prisma:migrate",
    "orval": "bun run --cwd packages/api-client generate",
    "hello": "bun run --cwd scripts hello"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "next": "15.5.13",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "esbuild>@esbuild/darwin-arm64": "-",
