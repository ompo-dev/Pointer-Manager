{
  "name": "@point-manager/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "scripts": {
    "generate": "cd ../.. && bun run --cwd scripts openapi && node ./node_modules/orval/dist/bin/orval.js --config ./packages/api-client/orval.config.ts",
    "build": "bun run generate",
    "typecheck": "cd ../.. && node ./node_modules/typescript/lib/tsc.js -p packages/api-client/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "orval": "^7.8.0",
    "typescript": "^5.9.2"
  }
}
