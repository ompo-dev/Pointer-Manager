{
  "name": "@point-manager/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outdir dist",
    "start": "bun run dist/index.js",
    "test": "bun run prisma:migrate:deploy && bun test",
    "test:watch": "bun test --watch",
    "typecheck": "cd ../.. && node ./node_modules/typescript/lib/tsc.js -p apps/api/tsconfig.json --noEmit",
    "prisma:generate": "cd ../.. && node ./node_modules/prisma/build/index.js generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "cd ../.. && node ./node_modules/prisma/build/index.js migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:deploy": "cd ../.. && node ./node_modules/prisma/build/index.js migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:seed": "bun run prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/swagger": "^1.3.1",
    "@point-manager/auth": "file:../../packages/auth",
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.2",
    "elysia": "^1.3.21",
    "jose": "^6.2.1",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "socket.io": "^4.8.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "bun-types": "^1.3.6",
    "prisma": "6.19.2",
    "typescript": "^5.9.2"
  }
}
